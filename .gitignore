# Ignorar configuraciones de obsidian
#.obsidian

# Ignorar el estado de la sesión de obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Ignorar caché y datos temporales de obsidian
.obsidian/graph.json
.obsidian/appearance.json
.obsidian/plugins/*/data.json

# Ignorar el venv de Procesamiento de señales biomédicas, pero todas las librerias utilizadas se encuenrtan en el requirements.txt
Procesamiento/Codigos/.venv/

# Ignorar el entorno de pruebas de Telecomunicaciones
Telecomunicacion/Entorno-ESP32/

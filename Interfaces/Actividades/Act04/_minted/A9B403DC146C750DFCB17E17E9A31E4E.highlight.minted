\PYG{+w}{  }\PYG{c+c1}{// 2. FASE DE LECTURA NORMAL DEL SENSOR}
\PYG{+w}{  }\PYG{c+c1}{// ====================================================================}
\PYG{+w}{  }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{tiempo\PYGZus{}actual}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{tiempo\PYGZus{}ultimo\PYGZus{}muestreo}\PYG{+w}{ }\PYG{o}{\PYGZgt{}=}\PYG{+w}{ }\PYG{n}{intervalo\PYGZus{}muestreo}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{sensors\PYGZus{}event\PYGZus{}t}\PYG{+w}{ }\PYG{n}{a}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{g}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{temp}\PYG{p}{;}

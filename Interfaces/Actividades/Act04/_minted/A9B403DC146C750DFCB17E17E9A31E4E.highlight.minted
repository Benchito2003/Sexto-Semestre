\PYG{+w}{        }\PYG{n}{offset\PYGZus{}Pitch\PYGZus{}Nod}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{suma\PYGZus{}Pitch\PYGZus{}calibracion}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{l+m+mf}{15.0}\PYG{p}{;}
\PYG{+w}{        }\PYG{n}{offset\PYGZus{}Roll\PYGZus{}Doorknob}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{suma\PYGZus{}Roll\PYGZus{}calibracion}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{l+m+mf}{15.0}\PYG{p}{;}
\PYG{+w}{        }\PYG{n}{calibrando\PYGZus{}centro}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// Salimos del modo calibración}

\PYG{+w}{      }\PYG{n}{suma\PYGZus{}Pitch\PYGZus{}calibracion}\PYG{+w}{ }\PYG{o}{+=}\PYG{+w}{ }\PYG{n}{atan2}\PYG{p}{(}\PYG{n}{a}\PYG{p}{.}\PYG{n}{acceleration}\PYG{p}{.}\PYG{n}{y}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{sq}\PYG{p}{(}\PYG{n}{a}\PYG{p}{.}\PYG{n}{acceleration}\PYG{p}{.}\PYG{n}{x}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{sq}\PYG{p}{(}\PYG{n}{a}\PYG{p}{.}\PYG{n}{acceleration}\PYG{p}{.}\PYG{n}{z}\PYG{p}{)))}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{RAD\PYGZus{}TO\PYGZus{}DEG}\PYG{p}{;}
